# Supply these values in the hosting dashboard; do not commit the real password.
QAIF_ADMIN_PASSWORD=replace-with-a-private-password
QAIF_PUBLIC_DEPLOYMENT=true
QAIF_DEMO_MODE=true
QAIF_SECURE_COOKIE=true
QAIF_DATA_DIR=/data
QAIF_PUBLIC_BASE_URL=https://your-qaif-host.example
# On Render, RENDER_EXTERNAL_URL supplies the URL if QAIF_PUBLIC_BASE_URL is omitted.
# Trust all forwarded headers only inside a managed service behind its trusted proxy.
FORWARDED_ALLOW_IPS=*
PORT=8765
